<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paper Format -->
    <record id="paper_format_quote_pics_mrp_order" model="report.paperformat">
        <field name="name">European A4 low margin</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="header_spacing">23</field>
        <field name="margin_bottom">28</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_quotations_mrp_order" model="ir.actions.report">
        <field name="name">Download Order</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">oi_luluat_mrp_order.report_quot_mrp_order</field>
        <field name="report_file">oi_luluat_mrp_order.report_quot_mrp_order</field>
        <field name="paperformat_id"
               ref="oi_luluat_mrp_order.paper_format_quote_pics_mrp_order"/>
    </record>

</odoo>