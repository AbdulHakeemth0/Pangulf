<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paper_format_quote_pics_delivery" model="report.paperformat">
            <field name="name">European A4 low margin</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="header_spacing">23</field>
            <field name="margin_bottom">28</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_quotations_delivery" model="ir.actions.report">
            <field name="name">Download Delivery Report - Pic</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">oi_luluat_delivery_report.report_quot_delivery</field>
            <field name="report_file">oi_luluat_delivery_report.report_quot_delivery</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="oi_luluat_quot_with_pic.paper_format_quote_pics"/>
            <field name="print_report_name">'Delivery Report - %s' % (object.name)</field>
        </record>
    </data>
</odoo>
