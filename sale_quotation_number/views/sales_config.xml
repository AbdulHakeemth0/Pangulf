<odoo>
    <record id="res_config_settings_view_form_quotation_number" model="ir.ui.view">
        <field name="name">Quotation number configuration</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='proforma_configuration']" position="after">
                <setting id="sale_quotation_number" string="Use Same Enumeration" help="If this is unchecked, quotations use a different sequence from sale orders">
                    <field name="keep_name_so" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
