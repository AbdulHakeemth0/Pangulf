<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="so_view_form_quotation_number" model="ir.ui.view">
        <field name="name">sale.order.form.oi.luluat.discount</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']/field[@name='payment_term_id']" position="after">
                <field name="emp_master" options="{'no_create': True, 'no_open': True}"/>
                <field name="payment_mode"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sales_person']/div[@id='require_payment']" position="after">
                <field name="enable_sign"/>
            </xpath>
            <xpath expr="//group[@name='sale_total']/field[@name='tax_totals']" position="after">
                <field name="total_discount_only" invisible="1"/>
                <field name="total_tax_only" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="res_view_form" model="ir.ui.view">
        <field name="name">res.company.form.oi.luluat.sale.order</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="footer" widget="image" class="oe_avatar"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="sign" widget="image" class="oe_avatar"/>
            </xpath>
        </field>
    </record>

    <record id="payment_mode_tree_view" model="ir.ui.view">
        <field name="name">payment.mode.list</field>
        <field name="model">payment.mode</field>
        <field name="arch" type="xml">
            <list string="Payment Modes">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="payment_mode_form_view" model="ir.ui.view">
        <field name="name">payment.mode.form</field>
        <field name="model">payment.mode</field>
        <field name="arch" type="xml">
            <form string="Payment Mode">
                <sheet>
                    <group name="payment_mode">
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_payment_mode" model="ir.actions.act_window">
        <field name="name">Payment Mode</field>
        <field name="res_model">payment.mode</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first record</p>
        </field>
    </record>

    <menuitem
        id="payment_mode_menu_config_master"
        name="Payment Mode"
        sequence="8"
        parent="sale.menu_sale_config"
        action="action_payment_mode"
    />
</odoo>
