<odoo>
	<template id="report_saleorder_annexure_document">
    <t t-call="oi_luluat_quot_with_pic.custom_layout">
        <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
        <div class="page">
            <div class="oe_structure"/>
            <p><center><strong><u>QUOTATION</u></strong></center></p>
            <p>
            Date : <span t-field="doc.date_order" t-options="{&quot;format&quot;: &quot;dd.MM.yyyy&quot;}"/><br/>
            Ref : <span t-field="doc.client_order_ref"/>
            </p>
			<p>
				<t t-if="doc.partner_id.street">
					<span t-field="doc.partner_id.street"/>,
				</t>
				<t t-else="">
							<span t-field="doc.partner_id.street"/>
				</t>
				<t t-if="doc.partner_id.street2">
					<span t-field="doc.partner_id.street2"/>,
				</t>
				<t t-else="">
							<span t-field="doc.partner_id.street2"/>
				</t>
				<t t-if="doc.partner_id.city">
					<span t-field="doc.partner_id.city"/>,
				</t>
				<t t-else="">
							<span t-field="doc.partner_id.city"/>
				</t>
				<t t-if="doc.partner_id.state_id">
					<span t-field="doc.partner_id.state_id"/>,
				</t>
				<t t-else="">
							<span t-field="doc.partner_id.state_id"/>
				</t>
				<t t-if="doc.partner_id.country_id">
					<span t-field="doc.partner_id.country_id"/>,
				</t>
				<t t-else="">
							<span t-field="doc.partner_id.country_id"/>
				</t>
				<t t-if="doc.partner_id.zip">
					<span t-field="doc.partner_id.zip"/>,
				</t>
				<t t-else="">
							<span t-field="doc.partner_id.zip"/>
				</t>
				<t t-if="doc.partner_id.phone">
					<span t-field="doc.partner_id.phone"/>,
				</t>
				<t t-else="">
							<span t-field="doc.partner_id.phone"/>
				</t>
				<t t-if="doc.partner_id.email">
					<span t-field="doc.partner_id.email"/>
				</t>
			</p>
			
			<p>Subject: <strong><u><span t-field="doc.subject"/></u></strong></p>
			<p><span t-field="doc.content"/></p>
            
			<p><span t-field="doc.sale_term"/></p>
			
            <!-- Is there a discount on at least one line? -->
            <t t-set="display_discount" t-value="any(l.discount for l in doc.order_line)"/>

            <table class="table table-bordered" style="border: 2px solid black;">
                <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                <thead style="display: table-row-group">
                    <tr style="background-color:#e6e3e3;font-size:14px;border: 1px solid black;">
                    	<th style="border: 1px solid black;" name="th_description" class="text-left">S.No</th>
                        <th style="border: 1px solid black;" name="th_description" class="text-left">DESCRIPTION OF WORKS</th>
                        <th style="border: 1px solid black;" name="th_quantity" class="text-right">QTY</th>
                        <th style="border: 1px solid black;" name="th_priceunit" class="text-right">UNIT</th>
                        <th style="border: 1px solid black;" name="th_subtotal" class="text-right">RATE IN DHS</th>
                        <th style="border: 1px solid black;border-right: 2px solid black;" name="th_notax" class="text-right">AMOUNT</th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">
					          <t t-set="i" t-value="0"/>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="doc.order_line" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">
                            	<t t-if="line.display_type != 'line_section' and line.display_type != 'line_note'">
									<t t-set="i" t-value="i+1"/>
								</t>
								<td style="font-size:13px;border: 1px solid black;" class="text-center" name="td_no"><span t-if="line.display_type != 'line_section' and line.display_type != 'line_note'" t-esc="i"/>	</td>
                                <td style="font-size:13px;border: 1px solid black;" name="td_name"><span t-field="line.name"/></td>
                                <td style="font-size:13px;border: 1px solid black;" name="td_quantity" class="text-right">
                                    <span t-field="line.product_uom_qty"/>
                                </td>
                                <td style="font-size:13px;border: 1px solid black;" name="td_priceunit" class="text-center">
                                <span t-field="line.product_uom"/>
                                </td>
                                <td style="font-size:13px;border: 1px solid black;" class="text-right">                                
                                    <span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                </td>
                                <td style="font-size:13px;border: 1px solid black;border-right: 2px solid black;" name="td_taxes" class="text-right">
                                    <span t-esc="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/>
                                </td>                    
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td style="border: 1px solid black;background-color:#e6e3e3;border-right: 2px solid black;border-top: 1px solid black;" name="td_section_line" colspan="99">
                                    <span style="font-size:14px;" t-field="line.name"/>
                                </td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td style="border: 1px solid black;background-color:#e6e3e3;border-right: 2px solid black;border-top: 1px solid black;" name="td_note_line" colspan="99">
                                    <span style="font-size:14px;" t-field="line.name"/>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-right">
                                <td style="border-right: 2px solid black;border-bottom: 1px solid black;" name="td_section_subtotal" colspan="99">
                                    <strong class="mr16">Total:</strong> 
                                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
            <br/>
            <table class="table table-bordered" style="border: 2px solid black;">
                <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                <t t-set="i" t-value="0"/>
                <tbody class="sale_tbody">
                	<tr style="border: 1px solid black;background-color:#e6e3e3;border-right: 2px solid black;">
                	  <td style="border-right: 2px solid black;" name="td_section_subtotal" class="text-center" colspan="100">
                        <strong class="mr16"> SUMMARY</strong>
                    </td></tr>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="doc.order_line" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                        
                        <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal">
                                <t t-set="i" t-value="i+1"/>
                                <td style="border: 1px solid black;" name="td_section_subtotal" class="text-left" colspan="10">
                                    <strong class="mr16"> <span t-esc="i"/></strong>
                                </td>
                                <td style="border: 1px solid black;" name="td_section_subtotal" class="text-left" colspan="70">
                                    <strong class="mr16"> <span t-esc="current_section.name"/></strong>
                                </td>
                                <td style="border: 1px solid black;border-right: 2px solid black;" name="td_section_subtotal" class="text-right" colspan="20">
                                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="line.display_type == 'line_section'">    
                            
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                        </tr>
                        
                    </t>
                    <tr class="is-subtotal" style="border-right: 2px solid black;">
                              <td style="border: 1px solid black;border-right: 1px solid black;" name="td_section_subtotal" class="text-center" colspan="80">
                                  <strong class="mr16"> TOTAL IN AED</strong>
                              </td>
                              <td style="border: 1px solid black;border-right: 2px solid black;" name="td_section_subtotal" class="text-right" colspan="20">
                                  <span t-field="doc.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                              </td>
                          </tr>
                          <tr class="is-subtotal" style="border-right: 2px solid black;">
                              <td style="border: 1px solid black;border-right: 1px solid black;" name="td_section_subtotal" class="text-center" colspan="80">
                                  <strong class="mr16"> VAT 5 %</strong>
                              </td>
                              <td style="border: 1px solid black;border-right: 2px solid black;" name="td_section_subtotal" class="text-right" colspan="20">
                                  <span t-field="doc.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                              </td>
                          </tr>
                          <tr class="is-subtotal" style="border-right: 2px solid black;">
                              <td style="border: 1px solid black;border-right: 1px solid black;" name="td_section_subtotal" class="text-center" colspan="80">
                                  <strong class="mr16">GRAND TOTAL IN AED</strong>
                              </td>
                              <td style="border: 1px solid black;border-right: 2px solid black;" name="td_section_subtotal" class="text-right" colspan="20">
                                  <span t-field="doc.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                              </td>
                          </tr>
                </tbody>
            </table>				
        </div>
    </t>
</template>


		<template id="report_saleorder_annexure">
		    <t t-call="web.html_container">
		        <t t-foreach="docs" t-as="doc">
		            <t t-call="oi_luluat_sale_order.report_saleorder_annexure_document" t-lang="doc.partner_id.lang"/>
		        </t>
		    </t>
		</template>

		<record id="action_report_saleorder_annexure" model="ir.actions.report">
            <field name="name">Summary Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">oi_luluat_sale_order.report_saleorder_annexure</field>
            <field name="report_file">oi_luluat_sale_order.report_saleorder_annexure</field>
            <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>
</odoo>
