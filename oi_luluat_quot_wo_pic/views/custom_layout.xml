<odoo>
		<!--Bridge template-->
		<template id="custom_layout">
			<!-- Multicompany -->
			<t t-if="not o and doc">	<t t-set="o" t-value="doc"/>	</t>
				<t t-if="o and 'company_id' in o">
					<t t-set="company" t-value="o.company_id.sudo()"/></t>
					<t t-if="not o or not 'company_id' in o">
						<t t-set="company" t-value="res_company"/></t>

            		<!--call to the header template-->
			<!-- t-call = "module_name.header template id"-->
			<t t-call="oi_luluat_quot_wo_pic.custom_header_layout"/>
			<!--call to the body template-->
			<div class="article"><t t-out="0"/></div>
			<!--call to the footer template-->
			<t t-call="oi_luluat_quot_wo_pic.custom_footer_layout"/>
		</template>


